<robot name = "Robo1">




    <link name = "base_link">
        <visual>
            <origin xyz="0 0 0" />
            <geometry>
                <box size = "1.5 1.5 0.5" />
            </geometry>
            <material name = "blue">
                <color rgba= "0 0 1 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size = "1.5 1.5 0.5" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="5.0"/>
            <inertia
                ixx="1.0"
                ixy="0.0"
                ixz="0.0"
                iyy="1.0"
                iyz="0.0"
                izz="1.0"/>
        </inertial>
    </link>










    <link name = "left_wheel">
        <visual>
            <origin xyz = "0 0 0" rpy="0 1.5708 0" />
            <geometry>
                <cylinder length = "0.1" radius = "0.3" />
            </geometry>
            <material name = "black">
                <color rgba = "0 0 0 1" />
            </material>
        </visual>
        <collision>
            <origin xyz = "0 0 0" rpy="0 1.5708 0" />
            <geometry>
                <cylinder length = "0.1" radius = "0.3" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="1.0"/>
            <inertia
                ixx="0.05"
                ixy="0.0"
                ixz="0.0"
                iyy="0.05"
                iyz="0.0"
                izz="0.05"/>
        </inertial>
    </link>









    <link name = "right_wheel">
        <visual>
            <origin xyz = "0 0 0" rpy = "0 1.5708 0" />
            <geometry>
                <cylinder length="0.1" radius = "0.30" />
            </geometry>
            <material name = "black">
                <color rgba = "0 0 0 1" />
            </material>
        </visual>
        <collision>
            <origin xyz = "0 0 0" rpy = "0 1.5708 0" />
            <geometry>
                <cylinder length="0.1" radius = "0.30" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="1.0"/>
            <inertia
                ixx="0.05"
                ixy="0.0"
                ixz="0.0"
                iyy="0.05"
                iyz="0.0"
                izz="0.05"/>
        </inertial>
    </link>











    <link name = "caster_wheel">
        <visual>
            
            <geometry>
                <sphere radius="0.09" />
            </geometry>
            <material name = "red">
                <color rgba = "1 0 0 1" />
            </material>

        </visual>
        <collision>
            <geometry>
                <sphere radius="0.09" />
            </geometry>
            <origin xyz = "0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.2"/>
            <inertia
                ixx="0.001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.001"
                iyz="0.0"
                izz="0.001"/>
        </inertial>
    </link>











    <joint name = "caster_wheel_to_base_link" type = "fixed"> 
        <parent link = "base_link" />
        <child link = "caster_wheel" />
        <origin xyz = "0 -0.55 -0.3" rpy = "0 0 0" />
    </joint>


<joint name="right_wheel_to_base_link" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0.80 0.3 -0.1" />
    <axis xyz="1 0 0"/>
</joint>

<joint name="left_wheel_to_base_link" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="-0.80 0.3 -0.1" />
    <axis xyz="1 0 0" />
</joint>


   


<gazebo reference="base_link">
    <material>Gazebo/Blue</material>
</gazebo>

<gazebo reference="left_wheel">
    <material>Gazebo/Black</material>
</gazebo>

<gazebo reference="right_wheel">
    <material>Gazebo/Black</material>
</gazebo>

<gazebo reference="caster_wheel">
    <material>Gazebo/Red</material>
</gazebo>


<gazebo>
    <plugin
        name="diff_drive"
        filename="libgazebo_ros_diff_drive.so">

        <left_joint>left_wheel_to_base_link</left_joint>
        <right_joint>right_wheel_to_base_link</right_joint>

        <wheel_separation>1.5</wheel_separation>
        <wheel_diameter>0.6</wheel_diameter>

        <command_topic>cmd_vel</command_topic>
        <odometry_topic>odom</odometry_topic>

        <robot_base_frame>base_link</robot_base_frame>

        <publish_odom>true</publish_odom>
        <publish_wheel_tf>true</publish_wheel_tf>

    </plugin>
</gazebo>

</robot>





